DATASOURCE_URL=
DATASOURCE_DB=bethel-report
DATASOURCE_USERNAME=
DATASOURCE_PASSWORD=

CORS_ALLOWED_ORIGINS=

KEYCLOAK_ISSUER_URI=
KEYCLOAK_SERVICE_URL=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_REALM=
KEYCLOAK_ADMIN_CLIENT_ID=
FRONTEND_CLIENT_ID=
INVITATION_REDIRECT_URL=

# MinIO local. Use credenciais locais próprias; não versionar o arquivo .env.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=bethel-report

# RabbitMQ. Credenciais do broker de mensageria; não versionar o arquivo .env.
# Em Docker, use RABBITMQ_HOST=bethel-message-rabbitmq (container do bethel-message-broker).
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_EMAIL_EXCHANGE=email.exchange
RABBITMQ_EMAIL_ROUTING_KEY=email.send

# Política de anexos compartilhada pelos Conselhos; ajustável por ambiente.
# Tipos suportados: pdf,jpg,jpeg,png,webp,mp4,webm,docx,xlsx,pptx
PUBLICATION_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,webp,mp4,webm,docx,xlsx,pptx
PUBLICATION_MAX_FILE_SIZE=10MB
# Deve ser maior que o limite por arquivo para comportar o multipart.
PUBLICATION_MAX_REQUEST_SIZE=11MB
